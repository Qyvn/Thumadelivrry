{
  "name": "thuma",
  "version": "0.1.0",
  "private": true,
  "description": "THUMA — Everything-delivery super app for Cornubia Flats, KZN",
  "scripts": {
    "dev": "next dev --port 3456",
    "build": "prisma generate && next build",
    "start": "next start --port 3456",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "tsx src/lib/pricing.test.ts && tsx src/lib/order-lifecycle.test.ts && tsx src/lib/eligibility.test.ts && tsx src/lib/geo.test.ts",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:fe": "node scripts/fe-test.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.55.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}

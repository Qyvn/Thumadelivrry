# Copy to .env and fill in. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (SQLite, prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL, prisma/postgres/schema.prisma — selected automatically
# when DATABASE_URL starts with postgres:// or postgresql://):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thuma?sslmode=require"
#
# Serverless demo mode: leave DATABASE_URL unset (or file:) and set THUMA_USE_TMP_DB=1
# to copy data/demo.db into /tmp on cold start. Data is NOT durable in this mode.
# THUMA_USE_TMP_DB=1
#
# Run `prisma migrate deploy` during the Vercel build (Postgres only):
# THUMA_MIGRATE_ON_BUILD=1

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Duban"
NEXT_PUBLIC_LAUNCH_ZONE="Greater Durban"

# ---------------------------------------------------------------------------
# Payments — mock provider only. No real payments are processed until a gateway
# is integrated and these keys are set.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock_payfast"
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ENV=sandbox
# YOCO_SECRET_KEY=
# YOCO_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Optional integrations (not wired yet)
# ---------------------------------------------------------------------------
# MAPS_API_KEY=            # road-distance pricing (currently straight-line haversine)
# WHATSAPP_ACCESS_TOKEN=   # WhatsApp Cloud API order updates
# WHATSAPP_PHONE_NUMBER_ID=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SMTP_URL=

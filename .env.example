# SQLite for local development.
# On Vercel, omit this (or set THUMA_USE_TMP_DB=1) to bootstrap from data/demo.db into /tmp.
# For durable production, use PostgreSQL and change prisma/schema.prisma provider to "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thuma?schema=public"
DATABASE_URL="file:./dev.db"

# Session / app
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="THUMA"
NEXT_PUBLIC_LAUNCH_ZONE="Greater Durban"

# Payments — mock provider until real SA gateway credentials are configured.
# Supported targets: mock_payfast | payfast | peach | ozow (wire real SDK later)
PAYMENT_PROVIDER="mock_payfast"
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ENV=sandbox

# Object storage for product images / merchant documents (optional locally)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Maps / geocoding (optional — zone validation uses configured rules for now)
# MAPS_API_KEY=

# Notifications (optional)
# SMS_PROVIDER=
# SMTP_URL=
